  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a6c67cf053282214b9cdb6d167b72a08, type: 3}
  m_Name: 
  m_EditorClassIdentifier: '::'
  dialogues:
  - "Hi!!!, \u30DF\u30AF\u3060\u3088."
  - If you are looking for C#, well, he is not here :'(
  - He asked me to temporarily take care of this place for him. OwO
  - He has just left a moment ago in a hurry. . . >.<
  - If you see him, please ask him to come back quickly. . .
  - 'Because it is so boring in here T_T '
  - . . .
  - By the way, in case you meet him. . .
  - Please do not irritate him! O.O
  - "He is a sensitive person and will not TOLERATE any individuals that rage bait
    him!! >\uFE3F< "
  - 'That is all I have to say. . . Bye!!! (ToT)/~~~ '
  message_index: 0
  message: {fileID: 520710170}
  isTyping: 0
  typeSpeed: 0.07
